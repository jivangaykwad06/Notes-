<!DOCTYPE html><html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"><title>NoteVault — My Notes</title>

<link rel="stylesheet" href="style.css">

</head><body><!-- SPLASH SCREEN --><div class="splash">
    <div class="logo-animation">
        <div class="logo">📚</div>
        <h1>NoteVault</h1>
        <p>Your notes. Your knowledge.</p>
    </div>
</div><div class="app"><!-- HEADER -->
<header class="header">

    <div class="brand">
        <div class="brand-icon">📚</div>

        <div>
            <h2>NoteVault</h2>
            <small>Study smarter</small>
        </div>
    </div>

    <div class="header-actions">
        <button class="icon-btn" onclick="toggleDark()">🌙</button>
        <button class="icon-btn" onclick="openLogin()">🔐</button>
    </div>

</header>

<!-- HERO -->
<section class="hero">

    <div class="hero-content">

        <h1>Welcome to your notes 👋</h1>

        <p>
            All your study material in one beautiful place.
        </p>

        <div class="stats">

            <div class="stat">
                <strong id="noteCount">0</strong>
                <span>Notes</span>
            </div>

            <div class="stat">
                <strong id="subjectCount">0</strong>
                <span>Subjects</span>
            </div>

        </div>

    </div>

</section>

<!-- SEARCH -->
<div class="search-box">

    <span class="search-icon">🔍</span>

    <input
        type="text"
        id="search"
        placeholder="Search your notes..."
        oninput="renderNotes()"
    >

</div>

<!-- CONTENT -->
<section class="section">

    <div class="section-head">

        <h3>Subjects</h3>

        <span onclick="selectSubject('All')">
            View All
        </span>

    </div>

    <div class="subjects" id="subjects"></div>

    <div class="section-head notes-heading">

        <h3>My Notes</h3>

        <span id="resultText"></span>

    </div>

    <div class="notes" id="notes"></div>

</section>

</div><!-- ADMIN ADD BUTTON --><button
class="fab"
id="fab"
onclick="openNoteModal()"
style="display:none"

«»

+

</button><!-- LOGIN MODAL --><div class="modal" id="loginModal"><div class="modal-card login-card">

    <div class="login-icon">🔐</div>

    <div class="modal-head">

        <h2>Admin Login</h2>

        <button
            class="close"
            onclick="closeModal('loginModal')"
        >
            ×
        </button>

    </div>

    <p>
        Only the owner can manage notes.
    </p>

    <input
        id="password"
        type="password"
        placeholder="Enter admin password"
    >

    <button class="save-btn" onclick="login()">
        Login
    </button>

</div>

</div><!-- NOTE MODAL --><div class="modal" id="noteModal"><div class="modal-card">

    <div class="modal-head">

        <h2 id="modalTitle">
            Add Note
        </h2>

        <button
            class="close"
            onclick="closeModal('noteModal')"
        >
            ×
        </button>

    </div>

    <div class="form-group">

        <label>Note Title</label>

        <input
            id="noteTitle"
            placeholder="Example: OS Unit 1"
        >

    </div>

    <div class="form-group">

        <label>Subject</label>

        <select id="noteSubject">

            <option>AI</option>
            <option>Computer Networks</option>
            <option>DBMS</option>
            <option>DSA</option>
            <option>TOC</option>
            <option>IoT</option>
            <option>Other</option>

        </select>

    </div>

    <div class="form-group">

        <label>Note File</label>

        <label class="upload">

            📁 Tap to select PDF / Image

            <input
                type="file"
                id="noteFile"
                accept=".pdf,image/*"
            >

        </label>

        <small id="fileName"></small>

    </div>

    <button
        class="save-btn"
        onclick="saveNote()"
    >
        Save Note
    </button>

</div>

</div><!-- TOAST --><div class="toast" id="toast"></div><script src="script.js"></script></body>
</html>